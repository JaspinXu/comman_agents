# Copy this file to .env. Never commit the real API key.
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_MODEL=qwen3.6:35b
SOCLAAS_TIMEOUT=90
COMMAN_AGENTS_DB=data/comman_agents.db
# 留空 API Key/Base URL 时复用上面的 SoC LaaS 配置；模型必须具备 image 能力。
IMAGEGEN_API_KEY=
IMAGEGEN_BASE_URL=
IMAGEGEN_MODEL=
AGENT_IMAGE_PATH=data/agent_images
